# ==============================================================================
# CloudGallery - Environment Variables Configuration
# ==============================================================================

# Firebase Web App Authentication Configuration (Client-Side)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# AWS Serverless & CloudFront Endpoints (Client-Side)
VITE_AWS_REGION="us-east-1"
VITE_API_BASE_URL="https://api-gateway.execute-api.us-east-1.amazonaws.com"
VITE_CLOUDFRONT_URL="https://d123456abcdef8.cloudfront.net"

# Backend & Lambda Serverless Infrastructure (Injected in SAM template / server-side)
AWS_REGION="us-east-1"
AWS_S3_ORIGINALS_BUCKET="cloudgallery-originals-bucket"
AWS_S3_THUMBNAILS_BUCKET="cloudgallery-thumbnails-bucket"
AWS_DYNAMODB_TABLE="photos"
AWS_CLOUDFRONT_URL="https://d123456abcdef8.cloudfront.net"

# Server-side Mode (Hybrid emulation & direct AWS SAM support)
CLOUD_ENGINE_MODE="hybrid" # "aws-live" or "hybrid" (AWS architecture with high-fidelity cloud emulation)

# Server-Side AWS Credentials (Optional: for local development against live AWS services)
# NEVER EXPOSE IN FRONTEND!
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""


